NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend.example.com
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
# Required in production; must match the project reference in SUPABASE_URL.
SUPABASE_EXPECTED_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_SECRET_KEY=replace-with-server-only-secret
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Google Drive Proctoring Video Storage
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Option 1: Paste the entire Google service account JSON directly (raw string, path, or base64):
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@...iam.gserviceaccount.com"}'

# Option 2 (Alternative): Individual credentials
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 3 (Alternative): Path to downloaded JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional: Set to 'true' to allow anyone with the link to view the recorded video
# GOOGLE_DRIVE_MAKE_PUBLIC=false
